    "golden": "tsc -p tsconfig.sim.json && node tests/make-golden.mjs && node tests/find-tutorial-seed.mjs",
    "fairness": "tsc -p tsconfig.sim.json && node tests/fairness.mjs"
  },
  "dependencies": {
    "pixi.js": "^8"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "^7"
  }
}
