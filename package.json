{
  "name": "neon-shift-m0",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "tsc -p tsconfig.sim.json && node --test tests/headless.mjs",
